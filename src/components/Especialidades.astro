---
import { siteConfig } from "../config";
---

<section id="especialidades" class="py-20 md:py-24 bg-white relative overflow-hidden">
  <!-- Subtle gradient blobs -->
  <div class="absolute top-20 -left-32 w-[400px] h-[400px] bg-[var(--color-accent)]/3 rounded-full blur-[120px]"></div>
  <div class="absolute bottom-20 -right-32 w-[300px] h-[300px] bg-[var(--color-primary)]/3 rounded-full blur-[100px]"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="text-center mb-14 reveal">
      <p class="text-sm font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">Áreas de Especialización</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)]">Especialidades Médicas</h2>
      <div class="flex items-center justify-center gap-3 mt-4">
        <div class="h-px w-12 bg-[var(--color-accent)]/40"></div>
        <div class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></div>
        <div class="h-px w-12 bg-[var(--color-accent)]/40"></div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Cirugía Plástica -->
      <div class="specialty-card bg-[var(--color-surface-light)] border border-[var(--color-surface)] rounded-2xl overflow-hidden reveal stagger-1">
        <div class="h-1.5 bg-gradient-to-r from-[var(--color-primary)] via-[var(--color-accent)] to-[var(--color-primary-light)]"></div>
        <div class="p-8 md:p-10">
          <div class="flex items-center gap-4 mb-6">
            <span class="flex items-center justify-center w-14 h-14 bg-[var(--color-accent)]/8 text-[var(--color-accent)] rounded-xl border border-[var(--color-accent)]/15">
              <!-- Scalpel / aesthetic icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
              </svg>
            </span>
            <h3 class="text-xl md:text-2xl font-bold text-[var(--color-primary-dark)]">{siteConfig.especialidades[0].titulo}</h3>
          </div>

          <p class="text-[var(--color-primary)]/60 mb-6 leading-relaxed">{siteConfig.especialidades[0].descripcion}</p>

          <div class="grid grid-cols-2 gap-2.5">
            {siteConfig.especialidades[0].procedimientos.map((proc, i) => (
              <div class={`proc-item flex items-center gap-2.5 text-sm text-[var(--color-primary-dark)] bg-white rounded-lg px-3 py-2.5 border border-[var(--color-surface)] hover:border-[var(--color-accent)]/30 hover:shadow-sm transition-all duration-200`} style={`transition-delay: ${i * 50}ms`}>
                <span class="w-1.5 h-1.5 bg-[var(--color-accent)] rounded-full flex-shrink-0"></span>
                {proc}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Cirugía Bariátrica -->
      <div class="specialty-card bg-[var(--color-surface-light)] border border-[var(--color-surface)] rounded-2xl overflow-hidden reveal stagger-2">
        <div class="h-1.5 bg-gradient-to-r from-[var(--color-primary-light)] via-[var(--color-accent)] to-[var(--color-primary)]"></div>
        <div class="p-8 md:p-10">
          <div class="flex items-center gap-4 mb-6">
            <span class="flex items-center justify-center w-14 h-14 bg-[var(--color-accent)]/8 text-[var(--color-accent)] rounded-xl border border-[var(--color-accent)]/15">
              <!-- Heart / health icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
              </svg>
            </span>
            <h3 class="text-xl md:text-2xl font-bold text-[var(--color-primary-dark)]">{siteConfig.especialidades[1].titulo}</h3>
          </div>

          <p class="text-[var(--color-primary)]/60 mb-6 leading-relaxed">{siteConfig.especialidades[1].descripcion}</p>

          <div class="grid grid-cols-2 gap-2.5">
            {siteConfig.especialidades[1].procedimientos.map((proc, i) => (
              <div class={`proc-item flex items-center gap-2.5 text-sm text-[var(--color-primary-dark)] bg-white rounded-lg px-3 py-2.5 border border-[var(--color-surface)] hover:border-[var(--color-accent)]/30 hover:shadow-sm transition-all duration-200`} style={`transition-delay: ${i * 50}ms`}>
                <span class="w-1.5 h-1.5 bg-[var(--color-accent)] rounded-full flex-shrink-0"></span>
                {proc}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
