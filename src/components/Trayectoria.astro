---
import { siteConfig } from "../config";
---

<section id="trayectoria" class="py-20 md:py-28 bg-[var(--color-surface)]">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-14 reveal">
      <p class="text-sm font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">+13 Años de Experiencia</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)]">Trayectoria Profesional</h2>
    </div>

    <!-- Vertical Timeline -->
    <div class="relative">
      <!-- Animated vertical line -->
      <div class="absolute left-6 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 bg-[var(--color-primary-light)]/30">
        <div class="w-full bg-[var(--color-accent)] timeline-line-animated"></div>
      </div>

      <div class="space-y-12">
        {siteConfig.trayectoria.map((item, i) => {
          const isEven = i % 2 === 0;
          const isLast = i === siteConfig.trayectoria.length - 1;
          return (
            <div class={`relative flex items-start gap-6 md:gap-0 reveal stagger-${Math.min(i + 1, 5)}`}>
              {/* Timeline dot */}
              <div class={`absolute left-6 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full border-4 border-white z-10 flex-shrink-0 ${isLast ? 'bg-[var(--color-accent)] timeline-dot-active' : 'bg-[var(--color-primary)]'}`}></div>

              {/* Content card */}
              <div class={`ml-14 md:ml-0 md:w-[calc(50%-2rem)] ${isEven ? 'md:pr-0 md:mr-auto' : 'md:pl-0 md:ml-auto'}`}>
                <div class="bg-white rounded-xl p-5 shadow-sm border border-[var(--color-surface)] hover:shadow-md transition-shadow">
                  <span class="inline-block text-xs font-bold text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-2.5 py-1 rounded-full mb-2">
                    {item.año}
                  </span>
                  <h3 class="text-lg font-bold text-[var(--color-primary-dark)] mb-1">{item.titulo}</h3>
                  <p class="text-sm font-medium text-[var(--color-primary)] mb-2">{item.institucion}</p>
                  <p class="text-sm text-[var(--color-primary)]/60 leading-relaxed">{item.descripcion}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
