---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL?.replace(/\/$/, '') || '';
---

<section class="relative bg-[var(--color-surface-light)] min-h-screen flex items-center overflow-hidden">
  <!-- Subtle medical pattern background -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, var(--color-primary-dark) 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-0 w-full">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <!-- Text -->
      <div class="order-2 md:order-1">
        <div class="hero-badge flex flex-wrap items-center gap-2 mb-6">
          <span class="inline-flex items-center gap-1.5 bg-[var(--color-surface)] text-[var(--color-primary)] text-xs font-semibold px-3 py-1.5 rounded-full border border-[var(--color-primary-light)]/30">
            CMP {siteConfig.credentials.cmp}
          </span>
          <span class="inline-flex items-center gap-1.5 bg-[var(--color-surface)] text-[var(--color-primary)] text-xs font-semibold px-3 py-1.5 rounded-full border border-[var(--color-primary-light)]/30">
            RNSE {siteConfig.credentials.rnsePlastica}
          </span>
          <span class="inline-flex items-center gap-1.5 bg-[var(--color-surface)] text-[var(--color-primary)] text-xs font-semibold px-3 py-1.5 rounded-full border border-[var(--color-primary-light)]/30">
            RNE {siteConfig.credentials.rneGeneral}
          </span>
        </div>

        <h1 class="hero-title text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-primary-dark)] leading-tight mb-3">
          {siteConfig.name}
        </h1>

        <p class="hero-subtitle text-lg sm:text-xl text-[var(--color-accent)] font-medium mb-4">
          {siteConfig.title}
        </p>

        <p class="hero-tagline text-base text-[var(--color-primary)]/70 mb-8 max-w-lg leading-relaxed">
          {siteConfig.tagline}
        </p>

        <div class="hero-cta flex flex-wrap gap-3 mb-10">
          <a href={siteConfig.clinica.whatsapp} target="_blank" rel="noopener noreferrer"
            class="btn-primary inline-flex items-center gap-2 bg-[var(--color-accent)] text-white px-6 py-3 rounded-lg font-semibold text-sm">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Agendar Consulta
          </a>
          <a href="#especialidades"
            class="inline-flex items-center gap-2 border-2 border-[var(--color-primary-dark)] text-[var(--color-primary-dark)] px-6 py-3 rounded-lg font-semibold text-sm hover:bg-[var(--color-primary-dark)] hover:text-white transition-colors">
            Ver Especialidades
          </a>
        </div>

        <!-- Stats -->
        <div class="hero-stats grid grid-cols-3 gap-4 max-w-md">
          {siteConfig.stats.map((stat) => (
            <div class="text-center">
              <div class="text-2xl sm:text-3xl font-bold text-[var(--color-primary-dark)]">{stat.value}</div>
              <div class="text-xs text-[var(--color-primary)]/60 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Photo -->
      <div class="order-1 md:order-2 flex justify-center">
        <div class="hero-photo relative">
          <div class="absolute -inset-3 bg-gradient-to-br from-[var(--color-primary-light)]/20 to-[var(--color-accent)]/10 rounded-2xl blur-xl"></div>
          <img
            src={`${base}/profile.png`}
            alt={siteConfig.name}
            class="relative w-64 sm:w-72 md:w-80 aspect-square object-cover rounded-2xl shadow-2xl border-4 border-white"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Shimmer bar -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bar-shimmer"></div>
</section>
