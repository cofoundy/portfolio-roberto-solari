---
import { siteConfig } from "../config";

const sedesMaps = [
  {
    ...siteConfig.clinica.sedes[0],
    query: "Av+Brasil+831,+Jesús+María,+Lima,+Peru",
  },
  {
    ...siteConfig.clinica.sedes[1],
    query: "Av+Del+Pinar+124,+Chacarilla,+Santiago+de+Surco,+Lima,+Peru",
  },
];
---

<section id="clinica" class="py-20 md:py-28 bg-[var(--color-surface)] relative overflow-hidden">
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-[var(--color-accent)]/3 rounded-full blur-[140px]"></div>
  <div class="absolute top-20 left-0 w-[300px] h-[300px] bg-[var(--color-primary)]/3 rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="text-center mb-14 reveal">
      <p class="text-sm font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">Agende Su Consulta</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)]">{siteConfig.clinica.nombre}</h2>
      <div class="flex items-center justify-center gap-3 mt-4">
        <div class="h-px w-12 bg-[var(--color-accent)]/40"></div>
        <div class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></div>
        <div class="h-px w-12 bg-[var(--color-accent)]/40"></div>
      </div>
      <p class="text-[var(--color-primary)]/50 mt-4 text-sm">{siteConfig.clinica.horario}</p>
    </div>

    <!-- Sede tabs -->
    <div class="flex justify-center gap-3 mb-8 reveal stagger-1">
      {sedesMaps.map((sede, i) => (
        <button
          class={`sede-tab px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 border ${i === 0 ? 'bg-[var(--color-accent)] text-white border-[var(--color-accent)] shadow-lg shadow-[var(--color-accent)]/20' : 'bg-white text-[var(--color-primary)] border-[var(--color-surface)] hover:border-[var(--color-accent)]/30'}`}
          data-sede={i}
        >
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            {sede.nombre}
          </span>
        </button>
      ))}
    </div>

    <!-- Map panels -->
    <div class="reveal stagger-2">
      {sedesMaps.map((sede, i) => (
        <div class={`sede-panel bg-white rounded-2xl overflow-hidden border border-[var(--color-surface)] shadow-lg transition-all duration-500 ${i === 0 ? '' : 'hidden'}`} data-panel={i}>
          <div class="h-1 bg-gradient-to-r from-[var(--color-primary)] via-[var(--color-accent)] to-[var(--color-primary-light)]"></div>

          <div class="grid md:grid-cols-5">
            {/* Map — 3 cols */}
            <div class="md:col-span-3 relative h-72 md:h-80 bg-[var(--color-surface)]">
              <iframe
                src={`https://www.google.com/maps?q=${sede.query}&output=embed&z=16`}
                class="absolute inset-0 w-full h-full border-0"
                loading={i === 0 ? "eager" : "lazy"}
                referrerpolicy="no-referrer-when-downgrade"
                title={`Ubicación ${sede.nombre}`}
              ></iframe>
            </div>

            {/* Info — 2 cols */}
            <div class="md:col-span-2 p-6 md:p-8 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <div class="flex items-center justify-center w-10 h-10 bg-[var(--color-accent)]/10 text-[var(--color-accent)] rounded-xl">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-[var(--color-primary-dark)]">{sede.nombre}</h3>
              </div>

              <p class="text-sm text-[var(--color-primary)]/60 mb-5 leading-relaxed">{sede.direccion}</p>

              <div class="space-y-3 text-sm">
                {siteConfig.clinica.telefonos.map((tel) => (
                  <a href={`tel:${tel.replace(/\s/g, '')}`} class="flex items-center gap-2.5 text-[var(--color-primary)]/60 hover:text-[var(--color-accent)] transition-colors">
                    <svg class="w-4 h-4 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    {tel}
                  </a>
                ))}
                <a href={`mailto:${siteConfig.clinica.email}`} class="flex items-center gap-2.5 text-[var(--color-primary)]/60 hover:text-[var(--color-accent)] transition-colors">
                  <svg class="w-4 h-4 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  {siteConfig.clinica.email}
                </a>
              </div>

              <a href={`https://www.google.com/maps/search/?api=1&query=${sede.query}`} target="_blank" rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] hover:underline">
                Abrir en Google Maps
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="reveal stagger-3 mt-10 bg-gradient-to-br from-[var(--color-primary-dark)] to-[var(--color-primary)] rounded-2xl p-8 md:p-10 text-center relative overflow-hidden">
      <!-- Pulse decoration -->
      <svg class="absolute top-1/2 left-0 w-full h-16 -translate-y-1/2 opacity-[0.06]" viewBox="0 0 1200 80" preserveAspectRatio="none">
        <path d="M0,40 L200,40 L230,10 L260,70 L290,20 L320,60 L350,40 L600,40 L630,10 L660,70 L690,20 L720,60 L750,40 L1200,40" fill="none" stroke="white" stroke-width="2"/>
      </svg>

      <h3 class="text-xl md:text-2xl font-bold text-white mb-3 relative">¿Listo para transformar su vida?</h3>
      <p class="text-white/60 mb-6 max-w-lg mx-auto text-sm relative">
        Programe una consulta personalizada. Evaluaremos su caso y le ofreceremos la mejor solución.
      </p>

      <a href={siteConfig.clinica.whatsapp} target="_blank" rel="noopener noreferrer"
        class="btn-primary relative inline-flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-lg font-bold text-sm shadow-lg shadow-[#25D366]/30">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Agendar por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.sede-tab');
    const panels = document.querySelectorAll('.sede-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const sedeIndex = tab.getAttribute('data-sede');

        tabs.forEach(t => {
          t.classList.remove('bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]', 'shadow-lg', 'shadow-[var(--color-accent)]/20');
          t.classList.add('bg-white', 'text-[var(--color-primary)]', 'border-[var(--color-surface)]');
        });
        tab.classList.remove('bg-white', 'text-[var(--color-primary)]', 'border-[var(--color-surface)]');
        tab.classList.add('bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]', 'shadow-lg', 'shadow-[var(--color-accent)]/20');

        panels.forEach(p => {
          if (p.getAttribute('data-panel') === sedeIndex) {
            p.classList.remove('hidden');
            p.style.opacity = '0';
            p.style.transform = 'translateY(10px)';
            requestAnimationFrame(() => {
              p.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
              p.style.opacity = '1';
              p.style.transform = 'translateY(0)';
            });
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
