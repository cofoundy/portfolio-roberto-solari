---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SobreMi from "../components/SobreMi.astro";
import Especialidades from "../components/Especialidades.astro";
import Trayectoria from "../components/Trayectoria.astro";
import Formacion from "../components/Formacion.astro";
import Testimonios from "../components/Testimonios.astro";
import Clinica from "../components/Clinica.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const base = import.meta.env.BASE_URL?.replace(/\/$/, '') || '';
---

<html lang="es" style={`--color-primary-dark:${siteConfig.colors.primaryDark};--color-primary:${siteConfig.colors.primary};--color-primary-light:${siteConfig.colors.primaryLight};--color-accent:${siteConfig.colors.accent};--color-surface:${siteConfig.colors.surface};--color-surface-light:${siteConfig.colors.surfaceLight}`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${siteConfig.name} — ${siteConfig.title}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://roberto-solari.cofoundy.dev/og.jpg" />
    <meta name="twitter:image" content="https://roberto-solari.cofoundy.dev/og.jpg" />
    <meta name="keywords" content="cirujano plástico Lima, cirugía bariátrica Lima, Dr Roberto Solari, rinoplastia, liposucción, manga gástrica, bypass gástrico, Clínica Solari" />
    <link rel="canonical" href="https://roberto-solari.cofoundy.dev/" />

    <!-- Schema.org Physician -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Physician",
      "name": "Dr. Roberto Solari Diaz",
      "jobTitle": "Cirujano Plástico y Bariátrico",
      "medicalSpecialty": ["PlasticSurgery", "Bariatric"],
      "url": "https://roberto-solari.cofoundy.dev/",
      "image": "https://roberto-solari.cofoundy.dev/profile.png",
      "telephone": "+51983385522",
      "email": "consultas@clinicasolari.pe",
      "sameAs": [
        "https://instagram.com/dr_solari",
        "https://facebook.com/Drsolari.cirugiaplasticaybariatrica",
        "https://linkedin.com/in/dr-roberto-solari-diaz-003294126"
      ],
      "worksFor": {
        "@type": "MedicalOrganization",
        "name": "Clínica Solari",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Brasil 831",
          "addressLocality": "Jesús María",
          "addressRegion": "Lima",
          "addressCountry": "PE"
        }
      },
      "alumniOf": [
        { "@type": "CollegeOrUniversity", "name": "Universidad San Martín de Porres" },
        { "@type": "CollegeOrUniversity", "name": "Universidad Nacional Federico Villarreal" }
      ],
      "memberOf": [
        { "@type": "MedicalOrganization", "name": "Sociedad Peruana de Cirugía Plástica" },
        { "@type": "MedicalOrganization", "name": "Sociedad de Cirujanos Generales del Perú" }
      ]
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} — {siteConfig.title}</title>
  </head>
  <body class="bg-white text-[var(--color-primary-dark)]">
    <Header />
    <main>
      <Hero />
      <SobreMi />
      <Especialidades />
      <Trayectoria />
      <Formacion />
      <Testimonios />
      <Clinica />
    </main>
    <Footer />

    <!-- Scroll Reveal -->
    <script>
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
